<?xml version="1.0" encoding="utf-8"?>
<!--
    Primer plano del icono: una bolsa de compras con una hoja.

    Los dos simbolos del caso en una sola figura: la bolsa es el
    rescate de excedentes, la hoja es el CO2 que se evita.

    Todo el dibujo vive dentro del circulo seguro de 66dp centrado en
    los 108dp del lienzo. Esa es la zona que ningun lanzador recorta;
    lo de afuera se puede perder segun la forma que use el telefono.

    Un solo color, crema (#FDF5EF), el mismo fondo de la app. Sin
    degradados: a 48dp en la pantalla de inicio no se distinguen y solo
    agregan peso. Ademas permite reusar este mismo archivo como icono
    monocromatico para los temas dinamicos de Android 13.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cuerpo de la bolsa -->
    <path
        android:fillColor="#FDF5EF"
        android:pathData="M34,46 L74,46 C76.2,46 78,47.8 78,50 L75.5,78 C75.2,80.3 73.3,82 71,82 L37,82 C34.7,82 32.8,80.3 32.5,78 L30,50 C30,47.8 31.8,46 34,46 Z" />

    <!-- Asa: dos trazos que suben desde la boca de la bolsa -->
    <path
        android:fillColor="#FDF5EF"
        android:pathData="M54,26 C46.8,26 41,31.8 41,39 L41,46 L47,46 L47,39 C47,35.1 50.1,32 54,32 C57.9,32 61,35.1 61,39 L61,46 L67,46 L67,39 C67,31.8 61.2,26 54,26 Z" />

    <!-- Hoja sobre la bolsa: el CO2 evitado -->
    <path
        android:fillColor="#D96D37"
        android:pathData="M54,56 C47,56 42,61 42,68 C42,70.5 42.8,72.7 44.2,74.4 C47,69.5 51,65.8 56,63.8 C52.2,66.8 49.3,70.6 47.7,75.2 C49.6,76.3 51.7,76 54,76 C61,76 66,71 66,64 C66,59 62,56 54,56 Z" />

</vector>

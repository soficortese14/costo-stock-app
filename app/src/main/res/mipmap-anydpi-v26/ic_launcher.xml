<?xml version="1.0" encoding="utf-8"?>
<!--
    Icono adaptativo (Android 8 en adelante).

    Se declaran tres capas y no una imagen fija porque cada fabricante
    recorta el icono con su propia forma. Android compone fondo y
    primer plano y aplica la mascara del telefono.

    monochrome es para el "tema de iconos" de Android 13: el sistema
    toma la silueta y la pinta con el color del fondo de pantalla.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>

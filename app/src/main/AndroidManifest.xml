<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Recurso nativo: ubicacion, para mostrar las ofertas cercanas.
         Declararlos aqui es la primera mitad; la segunda es pedirlos en
         tiempo de ejecucion desde OnboardingScreen. -->
    <!-- Necesario para que Coil descargue las fotos que publica un proveedor. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Segundo recurso nativo: la camara, para fotografiar el excedente. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Hay equipos sin camara. Se declara no obligatoria para que la app
        siga siendo instalable en ellos: la foto es opcional al publicar.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CostoStock">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CostoStock"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Desde Android 7 no se puede entregar un file:// a otra app.
            FileProvider crea un content:// temporal para que la camara
            escriba la foto en nuestra carpeta sin exponer el resto.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>